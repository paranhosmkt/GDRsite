{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/admin",
      "destination": "/admin/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "/api/:match*"
    },
    {
      "source": "/admin/:match*",
      "destination": "/admin/:match*"
    },
    {
      "source": "/uploads/:match*",
      "destination": "/uploads/:match*"
    },
    {
      "source": "/artigo/:slug*",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|WhatsApp|Facebot|Twitterbot|LinkedInBot|TelegramBot|Slackbot|Discordbot).*"
        }
      ],
      "destination": "/api/article-meta?slug=:slug"
    },
    {
      "source": "/materiais/:slug*",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|WhatsApp|Facebot|Twitterbot|LinkedInBot|TelegramBot|Slackbot|Discordbot).*"
        }
      ],
      "destination": "/api/article-meta?slug=:slug"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
