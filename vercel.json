{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/admin",
      "destination": "/admin/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "/api/:match*"
    },
    {
      "source": "/admin/:match*",
      "destination": "/admin/:match*"
    },
    {
      "source": "/uploads/:match*",
      "destination": "/uploads/:match*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
